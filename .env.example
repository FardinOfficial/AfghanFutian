# ─────────────────────────────────────────────────────────────────────────────
# Environment
# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env.local` and adjust.
#
# There are two kinds of variable here, and the difference matters:
#
#   VITE_*        Public. Vite inlines these into the browser bundle at BUILD
#                 time, so changing one requires a rebuild. Never a secret.
#
#   everything    Server-only. Read at RUNTIME by the Vercel Function in
#   else          `api/contact.js` and never shipped to the browser. These are
#                 the secrets, and they belong in the hosting provider's
#                 dashboard (Vercel → Settings → Environment Variables), not in
#                 a file that could be committed.
# ─────────────────────────────────────────────────────────────────────────────


# ── Client (public, build-time) ──────────────────────────────────────────────

# Origin of the contact API, WITHOUT a trailing slash.
#
#   VITE_API_BASE_URL=https://api.afghanfutian.com
#     → the form posts to https://api.afghanfutian.com/api/contact
#
#   (unset, the default)
#     → the form posts to /api/contact on the site's own origin, which is what a
#       reverse-proxied deployment wants. With the bundled Vercel Function this
#       is the correct setting: leave it unset.
#
# The full request/response contract is documented in src/lib/api.js.
VITE_API_BASE_URL=

# The official Cal.com event embedded on /schedule. The complete booking flow
# (availability, date/time, form, confirmation, Google Meet and manage links)
# is rendered by Cal.com; this value selects the event. A bare path or a full
# cal.com URL both work; a trailing slash or query string is ignored.
#
#   VITE_CAL_LINK=https://cal.com/afghanfutian/meeting
#   VITE_CAL_LINK=afghanfutian/meeting
#
# Set this to render the calendar. When it is empty, /schedule shows an honest
# "not connected" state. It is public and baked into the browser bundle at
# BUILD TIME; never put an API key or webhook secret in this namespace.
VITE_CAL_LINK=


# ── Server (secret, runtime — set in the host's dashboard) ───────────────────

# Resend API key. REQUIRED for the enquiry form to deliver mail. Without it the
# endpoint answers 503 and sends nothing, rather than pretending to succeed.
# Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiry notifications are delivered.
# Default: contact@afghanfutian.com
CONTACT_TO_EMAIL=contact@afghanfutian.com

# The sender. The address (or its domain) must be verified in Resend, or every
# send is rejected. Default:
#   Afghan Futian Website <website@afghanfutian.com>
CONTACT_FROM_EMAIL=

# Only set this if the website is served from a DIFFERENT origin to the function
# (i.e. you set VITE_API_BASE_URL above). It is the single origin allowed to call
# the endpoint cross-origin. Leave empty for the bundled same-origin setup.
CONTACT_ALLOWED_ORIGIN=

# ── Scheduling (server-only secrets) ──────────────────────────────────────────
# All of these are read at runtime by the consolidated Vercel Functions in api/
# through handlers in server/handlers/. None may ever be prefixed with VITE_ or
# placed in src/ or any other browser-imported module.

# Cal.com API key (Settings → Developer → API keys). Required for real
# availability and real bookings. Without it the scheduler answers 503.
CAL_API_KEY=

# Numeric Cal.com event type ID. Default: 7982708 (afghanfutian/meeting).
CAL_EVENT_TYPE_ID=7982708

# Write-only signing secret from the Cal.com webhook. Required before
# /api/schedule/webhook will trust any event. See README for setup steps.
CAL_WEBHOOK_SECRET=

# Secret used to sign cancel/reschedule capability links in confirmation emails.
# Use a long random value. If unset, CAL_API_KEY is used, but rotating the API
# key then invalidates every outstanding management link.
SCHEDULE_TOKEN_SECRET=

# Sender for scheduling mail. Must be a verified Resend sender. Default:
#   Afghan Futian <contact@afghanfutian.com>
SCHEDULE_FROM_EMAIL=

# Set to `true` ONLY after Cal.com's attendee confirmation/reschedule/cancel
# emails have been disabled (or you have accepted that both will be sent).
# Default is `false`: the company still gets our branded notification, while
# Cal.com remains the single source of attendee mail. Details in the README.
SCHEDULE_SEND_ATTENDEE_EMAILS=false

# Optional provider overrides. Leave empty unless Cal.com changes its API.
# CAL_API_VERSION pins every v2 contract version; CAL_API_BASE_URL points at a
# proxy or self-hosted Cal.com instance (default: https://api.cal.com/v2).
CAL_API_VERSION=
CAL_API_BASE_URL=

# Optional fallback cron endpoint (/api/schedule/reminder). Not required:
# reminders are registered with Resend `scheduledAt` at booking time. Vercel
# sends this value automatically as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=
